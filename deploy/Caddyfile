# Plain-HTTP Caddy config, used when the deployment has no domain name.
# Listens on :80 and reverse-proxies to the frontend container.
#
# For HTTPS with a locally-trusted certificate, use Caddyfile.tls instead:
#   cp deploy/Caddyfile.tls deploy/Caddyfile && docker compose ... up -d

{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	log {
		output stdout
		format console
	}

	reverse_proxy frontend:8080 {
		# Server-sent events for the live pipeline view.
		flush_interval -1
	}

	# Two mutually exclusive header blocks rather than a site-wide one plus an
	# override for /preview. Caddy runs `header` before `reverse_proxy`, and
	# when two blocks set the same key which one wins is not something to rely
	# on: the site-wide DENY first, the preview SAMEORIGIN "after" it, and the
	# preview iframe still arrived with DENY. Splitting on `path` makes each
	# request match exactly one block, so there is nothing to order.
	@preview path /preview/*
	header @preview {
		Strict-Transport-Security "max-age=0"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}

	@site not path /preview/*
	header @site {
		Strict-Transport-Security "max-age=0"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}