# Plain-HTTP Caddy config, used when the deployment has no domain name.
# Listens on :80 and reverse-proxies to the frontend container.
#
# For HTTPS with a locally-trusted certificate, use Caddyfile.tls instead:
#   cp deploy/Caddyfile.tls deploy/Caddyfile && docker compose ... up -d

{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=0"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}

	reverse_proxy frontend:8080 {
		# Server-sent events for the live pipeline view.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=0"
		-Server
	}
}