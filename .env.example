# Copy to .env and fill in a provider.
#
# Two supported providers, selected with LLM_PROVIDER:
#
#   groq    (recommended)  a Groq API key. A full run takes ~45-100 seconds.
#   gemini               a Gemini API key. Similar speed, tighter free quota.
#   local                Ollama on this machine. Free, private, but a run takes
#                        ~3-6 minutes on CPU because qwen2.5-coder manages only
#                        ~12 tok/s (3b) / ~6 tok/s (7b) without a GPU.
#
# Validate a key in a couple of seconds before starting a run:
#   python backend/evals/check_llm.py

# ---- provider selection ---------------------------------------------------
LLM_PROVIDER=groq
LLM_TIMEOUT=120

# ---- Gemini (LLM_PROVIDER=gemini)----------------------------------------
GEMINI_API_KEY=
# Ordered fallback list. Model ids are retired often — several now return 404
# for new accounts — so pinning a single id silently fails the whole run.
# Verified working: gemini-3-flash-preview, gemini-flash-latest
# gemini-3.8-flash intermittently returns 503 under load.
GEMINI_MODELS=gemini-3-flash-preview,gemini-flash-latest,gemini-3.8-flash
# Pin exactly one id if you prefer (disables the list):
# GEMINI_MODEL=gemini-3-flash-preview
# The flash models spend output tokens on reasoning before answering; a small
# cap returns empty content with finishReason=MAX_TOKENS.
GEMINI_MAX_OUTPUT_TOKENS=8192

# ---- Ollama (LLM_PROVIDER=local) -----------------------------------------
SKIP_OLLAMA=1
PREFER_LOCAL_ONLY=1
OLLAMA_URL=http://localhost:11434
# Per-role models. The Designer uses the larger one for structured YAML; the
# code-generating roles use the smaller one because at ~12 vs ~6 tok/s it
# roughly halves wall time. Override any single role.
OLLAMA_MODEL_PM=qwen2.5-coder:3b
OLLAMA_MODEL_DESIGNER=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_MODEL_DEVELOPER=qwen2.5-coder:3b
OLLAMA_MODEL_TESTER=qwen2.5-coder:3b
OLLAMA_MODEL_REVIEWER=qwen2.5-coder:3b
# A full app takes minutes at the above throughput. Do not lower this.
OLLAMA_TIMEOUT=600

# ---- other hosted fallbacks (LLM_PROVIDER=auto only) ----------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
HF_TOKEN=
# OPENAI_API_KEY

# ---- reasoning (think before answering) ------------------------------------
# A reasoning role gets a model that deliberates first; the thinking comes back
# in meta["reasoning"] and $RUNS_DIR/llm_log.jsonl, never mixed into the answer.
#
# Roles that ask for it. Every role except the Reviewer by default.
#   LLM_REASONING=0            kill switch, disables every role
#   LLM_REASONING_ROLES=...    replaces this list (empty string = none)
#   LLM_REASONING_ROLE_<ROLE>=1  adds one role back, e.g. ..._ROLE_REVIEWER=1
LLM_REASONING_ROLES=pm,reasoner,designer,developer,tester,triage,reflection
# none|default|minimal|low|medium|high|xhigh|max. Clamped down to whatever the
# serving model accepts, so an out-of-range value is not a 400.
# Per role: LLM_REASONING_EFFORT_REVIEWER=high
LLM_REASONING_EFFORT=medium
# Gemini thinkingBudget in tokens (per role: LLM_REASONING_BUDGET_<ROLE>).
# The 2.5 series understands only a budget; set this to use a Gemini 3.x level
# instead: GEMINI_THINKING_LEVEL=low
LLM_REASONING_BUDGET=1024
# Reasoning is billed against the answer's completion ceiling, so that ceiling
# is doubled for a reasoning call. LLM_REASONING_MAX_TOKENS raises the floor
# for long artefacts (a 4000-token Designer answer may need it).
# LLM_REASONING_MAX_TOKENS=16384
# Ids to lead with when a reasoning role asks. Without these the roster falls
# back to its reasoning-capable entries (gpt-oss, qwen3) first.
# GROQ_REASONING_MODEL=openai/gpt-oss-120b
# OPENROUTER_REASONING_MODEL=openai/gpt-oss-20b:free

# ---- authentication (required in production) -------------------------------
AUTH_USERNAME=admin
# Random 48+ char string. Rotating it invalidates every existing session.
AUTH_SECRET=
# scrypt hash, NOT the plain password. Generate with: python backend/scripts/gen_auth.py
AUTH_PASSWORD_HASH=
# Optional key for headless access via the X-API-Key header.
AUTH_API_KEY=
# Set to 1 once the deployment is behind HTTPS.
AUTH_COOKIE_SECURE=0
# Session lifetime in hours.
AUTH_SESSION_HOURS=12
# Double-submit CSRF protection on POST/PUT/PATCH/DELETE. Leave at 1.
AUTH_CSRF=1