# Copy to .env — no local pull needed. Pick ANY ONE free provider to start.
# SKIP_OLLAMA=1 forces deterministic template mode (recommended on a small VM).

SKIP_OLLAMA=1

# ---------------------------------------------------------------------------
# Authentication (REQUIRED in production)
# Generate with:  python backend/scripts/gen_auth.py
# ---------------------------------------------------------------------------
AUTH_USERNAME=admin
# Random 48+ char string. Rotating it invalidates every existing session.
AUTH_SECRET=
# scrypt hash, NOT the plain password.
AUTH_PASSWORD_HASH=
# Optional key for headless access via the X-API-Key header.
AUTH_API_KEY=
# Set to 1 once the deployment is behind HTTPS; the cookie then refuses to
# travel over plain HTTP.
AUTH_COOKIE_SECURE=0
# Session lifetime in hours.
AUTH_SESSION_HOURS=12
# Double-submit CSRF protection on POST/PUT/PATCH/DELETE. Leave at 1.
AUTH_CSRF=1

# 1. Google AI Studio — best free tier (Flash, 15 RPM / 1500 RPD, 1M ctx, no card)
# Get: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. Groq — fastest LPU, 14.4k req/day, no card — https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-32b

# 3. OpenRouter — :free models, 50 req/day, no card — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=cohere/north-mini-code:free

# 4. GitHub Models — free with GitHub account — https://github.com/settings/tokens
# GITHUB_TOKEN=
# GITHUB_MODEL=openai/gpt-4o-mini

# 5. HuggingFace — small monthly credit — https://huggingface.co/settings/tokens
# HF_TOKEN=

# Paid fallback last (optional)
# OPENAI_API_KEY=